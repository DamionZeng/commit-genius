{
  "name": "git-genius",
  "displayName": "Git Genius",
  "description": "AI-powered Conventional Commit, CHANGELOG, and PR description generator.",
  "version": "0.0.1",
  "publisher": "your-publisher-id",
  "license": "MIT",
  "homepage": "https://github.com/your-username/git-genius#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/git-genius.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/git-genius/issues"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "gpt",
    "changelog",
    "pr",
    "conventional-commits",
    "workflow"
  ],
  "icon": "media/icon-dark.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Source Control",
    "AI",
    "Productivity"
  ],
  "activationEvents": [
    "onCommand:gitGenius.generateCommitMessage",
    "onCommand:gitGenius.generateChangelog",
    "onCommand:gitGenius.generatePrDescription",
    "onCommand:gitGenius.openPanel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitGenius.generateCommitMessage",
        "title": "Git Genius: Generate Commit Message"
      },
      {
        "command": "gitGenius.generateChangelog",
        "title": "Git Genius: Generate CHANGELOG"
      },
      {
        "command": "gitGenius.generatePrDescription",
        "title": "Git Genius: Generate PR Description"
      },
      {
        "command": "gitGenius.openPanel",
        "title": "Git Genius: Open",
        "icon": {
          "light": "media/icon-light.png",
          "dark": "media/icon-dark.png"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gitGenius.openPanel",
          "when": "editorTextFocus",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Git Genius",
      "properties": {
        "gitGenius.ai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible API base URL."
        },
        "gitGenius.ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the AI provider."
        },
        "gitGenius.ai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model name for chat completions."
        },
        "gitGenius.ai.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for the AI model."
        },
        "gitGenius.commit.diffScope": {
          "type": "string",
          "enum": [
            "staged",
            "workingTree"
          ],
          "default": "staged",
          "description": "Which diff to use when generating commit messages."
        },
        "gitGenius.changelog.path": {
          "type": "string",
          "default": "CHANGELOG.md",
          "description": "Output path for generated changelog (relative to workspace root)."
        },
        "gitGenius.pr.platform": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "bitbucket"
          ],
          "default": "github",
          "description": "Target platform format for PR description."
        },
        "gitGenius.pr.baseRef": {
          "type": "string",
          "default": "",
          "description": "Base ref for PR comparison, e.g. origin/main. If empty, auto-detected."
        },
        "gitGenius.pr.includeChecklist": {
          "type": "boolean",
          "default": true,
          "description": "Include a lightweight review checklist in the generated PR description."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.19",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^2.26.0",
    "eslint": "^8.57.0",
    "glob": "^10.3.10",
    "mocha": "^10.3.0",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "simple-git": "^3.25.0"
  }
}
